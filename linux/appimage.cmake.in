# Only a requested Release install may download tools or create an AppImage.
if(NOT CMAKE_INSTALL_CONFIG_NAME STREQUAL "Release" OR
   NOT "$ENV{MESHCORE_BUILD_APPIMAGE}" STREQUAL "1")
  return()
endif()

function(mco_package_appimage)
  include("@CMAKE_CURRENT_SOURCE_DIR@/flutter/ephemeral/generated_config.cmake")
  execute_process(
    COMMAND "@CMAKE_COMMAND@" -E env "MESHCORE_APPIMAGE_FLUTTER_ROOT=${FLUTTER_ROOT}"
      bash "@CMAKE_CURRENT_SOURCE_DIR@/../scripts/build_appimage.sh"
      "@CMAKE_CURRENT_SOURCE_DIR@/.." "${CMAKE_INSTALL_PREFIX}"
      "@CMAKE_CURRENT_BINARY_DIR@" "${CMAKE_INSTALL_CONFIG_NAME}" "@CMAKE_SYSTEM_PROCESSOR@"
    RESULT_VARIABLE appimage_result)
  if(NOT appimage_result STREQUAL "0")
    message(FATAL_ERROR "AppImage packaging failed (${appimage_result}). The Flutter bundle is still available.")
  endif()
endfunction()

mco_package_appimage()
