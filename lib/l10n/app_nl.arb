  "powerSaving_title": "Energiebesparing",
  "powerSaving_skipIdleDirectProgressParsing": "Voortgang alleen tijdens verzenden ontleden",
  "powerSaving_skipIdleDirectProgressParsingDescription": "Ontleedt geen radioframes voor de voortgang van directe bezorging zolang er geen verzendingen worden gevolgd. Ontvangst van berichten en bezorgbevestigingen blijven behouden.",
  "powerSaving_cacheChannelKeyHashes": "Kanaalparameters cachen",
  "powerSaving_cacheChannelKeyHashesDescription": "Hergebruikt de berekende hash van een ongewijzigde kanaalsleutel bij het verwerken van inkomende pakketten. Controle en ontsleuteling van berichten blijven behouden.",
  "powerSaving_pauseHiddenStatusAnimations": "Verborgen statusanimaties pauzeren",
  "powerSaving_pauseHiddenStatusAnimationsDescription": "Stopt verzendpuntjes en pulserende indicatoren buiten het zichtbare gebied, onder een ander scherm en als de app inactief is. Zichtbare indicatoren blijven geanimeerd.",
  "powerSaving_disableContinuousStatusAnimations": "Statische statusindicatoren",
  "powerSaving_disableContinuousStatusAnimationsDescription": "Vervangt de animatie van verzendpuntjes en het zachte pulseren van statusindicatoren door statische indicatoren, ook op het scherm. Statussen, herhalingstellers en verwerking van verzendingen blijven behouden.",
  "powerSaving_reduceBlePluginLogs": "Minder Bluetooth-diagnoselogs",
  "powerSaving_reduceBlePluginLogsDescription": "Vermindert de Bluetooth-diagnose-uitvoer op Android, iOS en macOS. Waarschuwingen, fouten en het framelogboek van de app blijven behouden. Geen effect op Windows, Linux of in een browser.",
  "powerSaving_deferBleLogDescriptions": "Beschrijvingen in het framelogboek uitstellen",
  "powerSaving_deferBleLogDescriptionsDescription": "Maakt de tekstbeschrijving pas wanneer die nodig is voor weergave of kopiëren. Framegegevens en tijdstempels worden direct opgeslagen; de inhoud van het logboek en de bescherming van privégegevens blijven gelijk.",
  "powerSaving_uiNotificationInterval": "Bijwerkinterval van de interface",
  "powerSaving_uiNotificationDescription": "Voegt gewone updates samen tijdens een stroom van gebeurtenissen. Een langer interval maakt de weergave minder actueel. Verwerking van pakketten en bevestigingen wordt niet vertraagd; wijzigingen van de verbindingsstatus houden het oorspronkelijke venster van 50 ms.",
  "powerSaving_milliseconds": "{milliseconds} ms",
