  "powerSaving_custom": "Eigen instellingen",
  "powerSaving_hiddenRadioStatsInterval": "Interval van radiostatistieken bij verborgen scherm",
  "powerSaving_seconds": "{seconds} s",
  "powerSaving_radioStatsDescription": "Geldt wanneer het scherm met radiostatistieken bedekt is of de app inactief is. Het zichtbare scherm wordt nog steeds elke seconde bijgewerkt. Andere functies kunnen vaker updates aanvragen.",
  "powerSaving_customDescription": "Minimale waarden behouden het oorspronkelijke gedrag. Je eigen instellingen worden apart van de vooringestelde profielen bewaard.",
  "powerSaving_presetDescription": "De waarden van een vooringesteld profiel liggen vast. Kies 'Eigen instellingen' om ze afzonderlijk aan te passen.",
  "powerSaving_pauseHiddenRadioIndicator": "Opvragen voor verborgen radio-indicator pauzeren",
  "powerSaving_pauseHiddenRadioIndicatorDescription": "Stopt het opvragen voor de indicator wanneer die verborgen of bedekt is of de app inactief is. Het verzenden van berichten en andere gebruikers van het opvragen houden de updates die ze nodig hebben.",
  "powerSaving_batteryInterval": "Opvraaginterval van de batterij van de node",
  "powerSaving_batteryDescription": "Geldt met de app open en op de achtergrond. De stiltedrempel voor de verbindingscontrole is {minutes} minuten; langere intervallen vertragen het herkennen van een verbinding die niet reageert. Handmatig bijwerken blijft beschikbaar.",
  "powerSaving_gpsInterval": "Bijwerkinterval van de GPS van de node",
  "powerSaving_gpsDescription": "Geldt met de app open en op de achtergrond, alleen als GPS op de node is ingeschakeld. Een langer interval maakt de weergegeven positie van de node minder actueel. GPS van de telefoon en wardrive worden apart ingesteld.",
  "powerSaving_pauseIdleImageCleanup": "Opschonen van afbeeldingen in rust pauzeren",
  "powerSaving_pauseIdleImageCleanupDescription": "Opschonen gebeurt alleen zolang er onvolledige afbeeldingen zijn of onlangs voltooide afbeeldingen die bewaard worden om duplicaten te herkennen. De wachttijd voor ontbrekende pakketten blijft gelijk.",
  "powerSaving_pauseHiddenGifs": "Verborgen GIF's pauzeren",
  "powerSaving_pauseHiddenGifsDescription": "Stopt GIF-frames buiten het zichtbare gebied, onder een ander scherm en als de app inactief is. Bij terugkeer gaat het afspelen verder, tenzij je de GIF handmatig hebt gepauzeerd.",
  "powerSaving_backgroundReconnectInterval": "Pauze tussen herverbindingen op de achtergrond",
  "powerSaving_backgroundReconnectDescription": "Alleen BLE en TCP, na de eerste zes pauzes van 1/2/4/8/16/30 seconden. Geldt als de app inactief is; terugkeren naar de app herstelt het normale ritme. Een langere pauze kan het herstel van de verbinding vertragen. De verbindingstijd komt bij de pauze.",
  "powerSaving_cpuSleepAlways": "CPU-slaap altijd toestaan wanneer mogelijk",
  "powerSaving_cpuSleepBle": "Bij een BLE-verbinding",
  "powerSaving_cpuSleepDescription": "Het apparaat laten slapen tussen bewerkingen. Afzonderlijke keuzes gelden op de achtergrond; alle actieve scenario's moeten slaap toestaan. De optie 'Altijd' geldt ongeacht het scenario.",
  "powerSaving_cpuSleepProxy": "Terwijl de companion-proxy draait",
  "powerSaving_cpuSleepTcp": "Bij een TCP-verbinding",
  "powerSaving_cpuSleepTitle": "CPU-slaap (Android)",
  "powerSaving_cpuSleepWardrive": "Terwijl wardrive draait",
  "powerSaving_cpuSleepUnconditional": "Altijd, zonder uitzonderingen",
  "powerSaving_cpuSleepUnconditionalDescription": "Geeft onze CPU-wake-locks volledig vrij, ook tijdens bewerkingen. Slaap van het apparaat kan ze vertragen of onderbreken. Wake-locks van Android en andere onderdelen blijven ongewijzigd.",
  "powerSaving_blePriorityTitle": "BLE-verbindingsmodus met de node",
  "powerSaving_blePriorityDescription": "Geldt na opnieuw verbinden met de node. 'Oorspronkelijk' vraagt niets aan; High geeft voorrang aan snelheid, Low power aan energiebesparing. Android en de node kiezen de werkelijke parameters; de zuinige modus kan de uitwisseling vertragen.",
  "powerSaving_bleOriginal": "Oorspronkelijk",
  "powerSaving_bleBalanced": "Gebalanceerd (Balanced)",
  "powerSaving_bleHigh": "Hoge snelheid (High)",
  "powerSaving_bleLowPower": "Energiebesparing (Low power)",
  "powerSaving_releaseTcpWifiLock": "Wifi niet wakker houden voor TCP",
  "powerSaving_releaseTcpWifiLockDescription": "Normale energiebesparing van wifi toestaan bij een TCP-verbinding met de node, ook via Tailscale. Geldt direct, op het scherm en op de achtergrond; de achtergronddienst en de instelling voor CPU-slaap blijven ongewijzigd. Op sommige apparaten zijn vertragingen of verbroken verbindingen mogelijk.",
  "powerSaving_reduceDeliveryObservationWrites": "Herschrijven van bezorgstatistieken beperken",
  "powerSaving_reduceDeliveryObservationWritesDescription": "Alleen het gewijzigde deel van de opgeslagen bezorgstatistieken bijwerken. Inhoud en volgorde blijven gelijk, het opslaan wordt niet extra uitgesteld.",
  "powerSaving_iosImmortalizerTitle": "iOS: uitvoering op de achtergrond",
  "powerSaving_iosImmortalizerDescription": "Experimentele opties voor het ingebouwde vasthouden van TCP op de achtergrond. Beschikbaar via 'Eigen instellingen'; de oorspronkelijke waarden behouden het huidige gedrag. Bescherming van frames en GPU blijft ingeschakeld.",
