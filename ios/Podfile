platform :ios, '16.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT not found in Generated.xcconfig. Try deleting Flutter/Generated.xcconfig, then run flutter pub get.'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# `flutter_onnxruntime` is a Swift pod that imports `onnxruntime-objc`, which
# ships without a module map — CocoaPods then refuses to link it statically.
# Asking for modular headers on that one dependency fixes it without forcing
# `use_modular_headers!` on every pod in the project. Only the AEIC-carrying
# profiles pull the plugin in, so the check keeps the lite profile from
# downloading a 47 MB runtime it never uses.
def uses_onnxruntime?
  manifest = File.expand_path(File.join('..', '.flutter-plugins-dependencies'), __dir__)
  File.exist?(manifest) && File.read(manifest).include?('flutter_onnxruntime')
end

target 'Runner' do
  pod 'onnxruntime-objc', :modular_headers => true if uses_onnxruntime?
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end